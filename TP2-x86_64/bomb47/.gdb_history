define walk
  set $node = (long *)$arg0
  if ($node == 0)
    printf "NULL\n"
    return
  end
  printf "Nodo en %p:\n", $node
  printf "  Valor: %ld\n", (long)$node[0]
  printf "  Izquierda: %p\n", (void*)$node[1]
  printf "  Derecha: %p\n", (void*)$node[2]
  walk $node[1]
  walk $node[2]
end
q
